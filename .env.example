# Core ERP Configuration
DJANGO_SECRET_KEY=change-this-to-a-secure-secret-key-in-production
DJANGO_DEBUG=True

# Multi-LLM Provider Selector: gemini | openai | claude | deepseek | qwen | custom
LLM_PROVIDER=gemini

# 1. Google Gemini (Google AI Studio) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 2. OpenAI / ChatGPT - https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Anthropic Claude - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 4. DeepSeek API - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 5. Alibaba Qwen (通义千问 / DashScope) - https://bailian.console.aliyun.com/
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 6. Custom / Local OpenAI-Compatible (Ollama, LM Studio, vLLM, OpenRouter)
CUSTOM_API_KEY=
CUSTOM_MODEL=llama3.3
CUSTOM_BASE_URL=http://localhost:11434/v1
